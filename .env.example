# Supabase (Project Settings → API). De publishable/anon key mag in de browser, de service role key nooit.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Alleen op de server: voor het versturen van alerts en het loggen van gebruik. Nooit NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

NEXT_PUBLIC_SITE_URL=https://nnvastgoed.nl
NEXT_PUBLIC_CONTACT_EMAIL=

# Mail (Resend). Zonder deze waarden worden er geen mails verstuurd; de rest werkt gewoon.
RESEND_API_KEY=
MAIL_FROM="NNvastgoed <noreply@nnvastgoed.nl>"
MAIL_MONTHLY_LIMIT=2000
MAIL_HOURLY_LIMIT=200

# Vercel Cron stuurt dit mee als Bearer-token naar /api/cron/alerts. Kies een lange willekeurige waarde.
CRON_SECRET=

# Lokaal zonder Supabase: voorbeeldwoningen. Werkt nooit in productie.
# DEMO_MODE=1
